{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rv-upload-service",
  "main": "src/index.js",
  "compatibility_date": "2026-09-11",
  "workers_dev": true,
  "vars": {
    "RV_UPLOAD_ENABLED": "false",
    "PUBLISH_MODE": "preview",
    "PREVIEW_BASE_REF": "codex/rv-upload-portal",
    "ALLOWED_ORIGINS": "https://larry890122.github.io",
    "GITHUB_REPOSITORY": "larry890122/rv-dashboard",
    "PUBLIC_MANIFEST_URL": "https://larry890122.github.io/rv-dashboard/integration-manifest.json"
  },
  "ratelimits": [
    {
      "name": "LOGIN_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {"limit": 5, "period": 60}
    },
    {
      "name": "PUBLISH_RATE_LIMITER",
      "namespace_id": "1002",
      "simple": {"limit": 3, "period": 60}
    }
  ]
}
